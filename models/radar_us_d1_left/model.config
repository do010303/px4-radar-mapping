<?xml version="1.0"?>
<model>
  <name>radar_us_d1_left</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Emulated 43 x 30 deg single-beam K-band radar altimeter, 0.5-50 m (Ainstein US-D1) (from profiles/us_d1.yaml).
    Gazebo has no radar sensor, so the field of view is sampled with a gpu_lidar
    ray grid and reduced to sparse radar detections in scripts/radar_model.py.
  </description>
</model>
