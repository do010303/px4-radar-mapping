<?xml version="1.0"?>
<!-- Generated by scripts/make_radar_model.py from profiles/us_d1.yaml; edit the profile, not this file. -->
<sdf version="1.9">
  <model name="radar_us_d1_right">
    <link name="radar_link_us_d1_right">
      <inertial>
        <mass>0.11</mass>
        <inertia>
          <ixx>0.000164</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.09e-05</iyy>
          <iyz>0</iyz>
          <izz>0.000111</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.02 0.108 0.079</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Field-of-view wireframe at 50 m. It moves with the link;
           visibility flag 0x2 is masked out of the radar below, so the radar
           does not detect it. -->
      <visual name="fov">
        <cast_shadows>false</cast_shadows>
        <visibility_flags>2</visibility_flags>
        <geometry>
          <mesh>
            <uri>model://radar_us_d1_right/meshes/fov.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <emissive>0.95 0.85 0.25 1</emissive>
        </material>
      </visual>
      <!-- 43 x 30 deg single-beam K-band radar altimeter, 0.5-50 m (Ainstein US-D1). Gazebo has no radar sensor type: the field of view is
           sampled with a ray grid, and scripts/radar_model.py turns the grid
           into the sparse, noisy detections such a radar reports. -->
      <sensor name="radar" type="gpu_lidar">
        <gz_frame_id>radar_link_us_d1_right</gz_frame_id>
        <topic>radar/scan_us_d1_right</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>87</samples>
              <resolution>1</resolution>
              <min_angle>-0.750492</min_angle>
              <max_angle>0.750492</max_angle>
            </horizontal>
            <vertical>
              <samples>61</samples>
              <resolution>1</resolution>
              <min_angle>-0.523599</min_angle>
              <max_angle>0.523599</max_angle>
            </vertical>
          </scan>
          <!-- Everything but the field-of-view wireframe (flag 0x2). -->
          <visibility_mask>4294967293</visibility_mask>
          <range>
            <min>0.5</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <update_rate>25</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
