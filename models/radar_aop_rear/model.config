<?xml version="1.0"?>
<model>
  <name>radar_aop_rear</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Emulated 75 x 104 deg short-range 3D mmWave point-cloud radar (IWR6843AOP, as in the paper) (from profiles/iwr6843aop.yaml).
    Gazebo has no radar sensor, so the field of view is sampled with a gpu_lidar
    ray grid and reduced to sparse radar detections in scripts/radar_model.py.
  </description>
</model>
