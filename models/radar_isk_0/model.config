<?xml version="1.0"?>
<model>
  <name>radar_isk_0</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Emulated 122 x 41 deg forward 3D mmWave point-cloud radar (IWR6843ISK, as in the paper) (from profiles/iwr6843isk.yaml).
    Gazebo has no radar sensor, so the field of view is sampled with a gpu_lidar
    ray grid and reduced to sparse radar detections in scripts/radar_model.py.
  </description>
</model>
