<?xml version="1.0"?>
<!-- Generated by scripts/make_radar_model.py from profiles/iwr6843aop.yaml; edit the profile, not this file. -->
<sdf version="1.9">
  <model name="radar_aop_right">
    <link name="radar_link_aop_right">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>2e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2e-05</iyy>
          <iyz>0</iyz>
          <izz>2e-05</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.02 0.08 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Field-of-view wireframe at 7 m. It moves with the link;
           visibility flag 0x2 is masked out of the radar below, so the radar
           does not detect it. -->
      <visual name="fov">
        <cast_shadows>false</cast_shadows>
        <visibility_flags>2</visibility_flags>
        <geometry>
          <mesh>
            <uri>model://radar_aop_right/meshes/fov.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <emissive>0.95 0.85 0.25 1</emissive>
        </material>
      </visual>
      <!-- 75 x 104 deg short-range 3D mmWave point-cloud radar (IWR6843AOP, as in the paper). Gazebo has no radar sensor type: the field of view is
           sampled with a ray grid, and scripts/radar_model.py turns the grid
           into the sparse, noisy detections such a radar reports. -->
      <sensor name="radar" type="gpu_lidar">
        <gz_frame_id>radar_link_aop_right</gz_frame_id>
        <topic>radar/scan_aop_right</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>76</samples>
              <resolution>1</resolution>
              <min_angle>-0.654498</min_angle>
              <max_angle>0.654498</max_angle>
            </horizontal>
            <vertical>
              <samples>53</samples>
              <resolution>1</resolution>
              <min_angle>-0.907571</min_angle>
              <max_angle>0.907571</max_angle>
            </vertical>
          </scan>
          <!-- Everything but the field-of-view wireframe (flag 0x2). -->
          <visibility_mask>4294967293</visibility_mask>
          <range>
            <min>0.2</min>
            <max>20</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
