        </collision>
        <visual name="visual">
        <visibility_flags>2</visibility_flags>
          <geometry><cylinder><radius>0.1</radius><length>12</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.3 0.3 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pole_left">
      <static>true</static>
      <pose>64 2.2 9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>18</length></cylinder></geometry>
        </collision>
        <visual name="visual">
