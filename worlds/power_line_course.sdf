        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <!-- Power line after the avoidance paper (docs/paper_malle2026_notes.md): two pylons 35 m apart at
         x = 30 (y = -17.5 and 17.5), a three-phase line of 20 mm wires 3 m apart on a cross-arm at 11 m,
         wires at x = 27, 30 and 33 m, z = 10 m, plus a 10 mm earth wire at z = 12 m. The wires
         are straight (no sag) and their visuals carry visibility flag 2, which the radar rays ignore:
         scripts/radar_array.py gives them the radar cross section of a thin cylinder instead
         (radar_model.wire_detections), as the ray grid cannot show something this thin.
         The vehicle spawns at the origin facing +X. -->
    <!-- A 30 cm trunk 2.5 m left of the line of flight along y = 0 at x = 14: outside the emergency-brake
         cone of scripts/avoid_node.py (23 deg off at 6 m), inside its avoidance sphere, so the tangent
         rule has something to go around before the wires. (At 0.7 m off, inside the cone, the vehicle
         just stops in front of it.) -->
    <model name="trunk">
      <static>true</static>
      <pose>14 2.5 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>15</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.4 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pylon_a">
      <static>true</static>
      <pose>30 -17.5 6.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>13</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>13</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pylon_b">
      <static>true</static>
      <pose>30 17.5 6.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>13</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>13</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crossarm_a">
      <static>true</static>
      <pose>30 -17.5 11 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.15 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.15 0.15</size></box></geometry>
          <material>
