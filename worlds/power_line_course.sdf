    <model name="wire_earth">
      <static>true</static>
      <pose>30 0 12 1.570796 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.005</radius><length>35</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <visibility_flags>2</visibility_flags>
          <geometry><cylinder><radius>0.005</radius><length>35</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- The obstacle course after the power line (scripts/avoid_node.py, goal 98 0 10): each one tries a
         different case of the avoidance rules, at the flight height of 10 m.
           wall_low      x 45: wall across the path, top at 9 m, 1 m below it            -> over
           wire_beam     x 55: pipe across the path at 11.5 m, 1.5 m above it (r 10 cm)  -> under
           pole_left     x 64: pole 2.2 m left of the path, 18 m tall                     -> past (outside the 2 m corridor)
           pole_right    x 68: pole 2.2 m right of the path                               -> past
           block_right   x 76: block from 1 m to 4 m right of the path, 12 m tall         -> over (in the corridor)
           wire_low      x 86: 10 mm wire across the path at 8.8 m, 1.2 m below it         -> over -->
    <model name="wall_low">
      <static>true</static>
      <pose>45 0 4.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 8 9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 8 9</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wire_beam">
      <static>true</static>
      <pose>55 0 11.5 1.570796 0 0</pose>
      <link name="link">
        <collision name="collision">
