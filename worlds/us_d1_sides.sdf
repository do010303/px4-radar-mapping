<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Coverage bench for the three US-D1 radars (models/x500_us_d1*): the vehicle takes off at the
       origin facing +X. Ahead: a 10 cm pole at 28 m and the 30 x 12 m wall at 40 m. Two 2 m boxes at
       bearing +-26.6 deg, 18 m out (inside the left / right radar's beam, outside the middle one's), and
       a 0.5 m post at bearing +22.5 deg, 30 m out: in the 2 deg gap between the left and the middle beam. -->
  <world name="us_d1_sides">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2500 2500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name="wall_40m">
      <static>true</static>
      <pose>40 0 6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 30 12</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 30 12</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_28m">
      <static>true</static>
      <pose>28 0 3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 0.1 6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 6</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="left_box_18m">
      <static>true</static>
      <pose>18 9 2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 2 4</size></box></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="right_box_18m">
      <static>true</static>
      <pose>18 -9 2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 2 4</size></box></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="gap_box_30m">
      <static>true</static>
      <pose>30 12.43 2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 4</size></box></geometry>
          <material><ambient>0.8 0.3 0.8 1</ambient><diffuse>0.8 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
