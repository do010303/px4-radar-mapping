    <!-- Survey site for radar mapping (docs/survey_mapping_plan.md, phase 0); the answers, for scoring,
         are in survey_site.truth.yaml. A power line along x between two pylons at x = 15 and 45 (y = 0):
         three 20 mm phase wires at y = -3, 0, 3 and z = 10 m and a 10 mm earth wire at z = 12 m, straight
         and hidden from the radar rays (visibility flag 2; scripts/radar_array.py gives them the radar
         cross section of a thin cylinder). Beside it a house and a wall (their broad faces towards the survey lines), a lamp post and a tree
         trunk (y = -10.75, midway between the line at y = -14 and the pass beside the power line at y = -7.5).
         scripts/survey_mission.py flies lines along x at y = -14 and 14, passes along the line (above it and
         at y = 8 and -7.5) and a circle around (30, 0): every object stays at least 3 m from the flight path. The vehicle spawns at the origin facing +X. -->
    <model name="pylon_a">
      <static>true</static>
      <pose>15 0 6.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>13</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>13</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
