    <!-- Obstacles for the radar hover test (scripts/hover_test.py). The vehicle
         spawns at the origin facing +X and hovers at about 2.5 m.

           target         where                     seen from the hover point
           wall           x 8, 4 m wide, 5 m tall   ahead, 7.8 m
           pole           (5, 3), 10 cm, 5 m tall   31 deg left, 5.6 m
           low box        (4, -2.5), top at 1.2 m   32 deg right, 1.3 m below
           overhead bar   (5, -4), at 3.5 m         39 deg right, 1 m above
           rear box       (-6, 0), 3 m tall         behind, 6 m
           side pole      (0, 7), 20 cm, 5 m tall   90 deg left, 7 m
           far walls      8 x 8 m                   30 m at 135 deg, 45 m at -100 deg
    -->
    <model name="wall">
      <static>true</static>
      <pose>8.1 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4 5</size></box></geometry>
          <material>
            <ambient>0.7 0.3 0.2 1</ambient>
            <diffuse>0.7 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
