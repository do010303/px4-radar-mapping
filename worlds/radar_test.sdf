<?xml version="1.0"?>
<!-- Static bench for the emulated radar: the sensor sits 1.5 m above ground
     looking along +X at four targets that differ in bearing, size and height.

       bearing (deg, +left)   target
         0                    wall, 10 m
       +30                    thin pole (10 cm), 6 m
       -30                    low box, top 0.3 m below the sensor plane, ~4.5 m
       -50                    overhead bar 0.5 m above the sensor plane, 8 m
-->
<sdf version="1.9">
  <world name="radar_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="radar_stand">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <include merge="true">
        <uri>model://radar_mmwave</uri>
      </include>
    </model>

    <model name="wall">
      <static>true</static>
      <pose>10.1 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 4 4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 4 4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.3 0.2 1</ambient>
            <diffuse>0.7 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pole">
      <static>true</static>
      <pose>5.196 3.0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.7 1</ambient>
            <diffuse>0.2 0.2 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_box">
      <static>true</static>
      <pose>4.33 -2.5 0.6 0 0 -0.5236</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="overhead_bar">
      <static>true</static>
      <pose>5.142 -6.128 2.0 0 0 -0.8727</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.1 1</ambient>
            <diffuse>0.7 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
