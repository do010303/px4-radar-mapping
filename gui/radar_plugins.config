
<!-- Added by examples/px4-mapping: raw radar rays. Pick /radar/scan in its
     topic list to see every ray the radar model starts from. -->
<plugin filename="VisualizeLidar" name="Visualize Lidar">
  <gz-gui>
    <title>Radar rays (/radar/scan)</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
</plugin>
